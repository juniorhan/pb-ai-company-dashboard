# 예시 파일입니다. 복사해 .env.local로 저장하고 이 PC의 경로를 적습니다.
# .env.local은 git에 올라가지 않습니다(PC마다 따로 둡니다).

# 실제 기록 파일(events.jsonl) 경로 목록. 세미콜론(;)으로 여러 개를 적으면 앞에서부터 처음 있는 파일을 씁니다.
# 예: 이 PC의 로컬 경로;Google Drive for desktop으로 동기화되는 경로
PBAI_EVENTS_PATHS=

# PB AI 회사 Wiki 정본 폴더('PB AI 회사' 폴더). 적어 두면
#  - npm run dev 의 로컬 대시보드가 조직을 Wiki에서 바로 읽고(항상 최신)
#  - npm run sync:org 가 공개용 사본 src/data/org.json 을 다시 만듭니다.
PBAI_WIKI_ORG_DIR=

# 1이면 같은 네트워크의 다른 기기도 /__pbai/* 로컬 데이터 주소를 읽을 수 있습니다. 기본은 이 PC에서만(0).
PBAI_ALLOW_LAN=0

# 배포 기준 경로를 바꿀 때만 적습니다(기본 /pb-ai-company-dashboard/).
VITE_BASE=
